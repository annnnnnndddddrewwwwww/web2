{
  "name": "novashop-reservation-system",
  "version": "1.0.0",
  "description": "Sistema de reservas con Google Calendar y notificaciones",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-spreadsheet": "^3.3.0",
    "googleapis": "^128.0.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "nodemon": "^3.0.1"
  },
  "build": {
    "appId": "com.novashop.reservation",
    "productName": "NovaShop Reservas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "node_modules/express/**/*",
      "node_modules/cors/**/*",
      "node_modules/googleapis/**/*",
      "node_modules/google-spreadsheet/**/*",
      "node_modules/nodemailer/**/*",
      "node_modules/dotenv/**/*"
    ],
    "win": {
      "target": [ "nsis" ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [ "dmg" ],
      "icon": "icon.icns"
    },
    "linux": {
      "target": [ "AppImage" ],
      "icon": "icon.png"
    }
  }
}